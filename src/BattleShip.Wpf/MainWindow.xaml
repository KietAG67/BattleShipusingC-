<Window x:Class="BattleShip.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BattleShip.Wpf.Views"
        xmlns:viewmodels="clr-namespace:BattleShip.Wpf.ViewModels"
        Title="BattleShip" Height="800" Width="1180" MinHeight="560" MinWidth="800"
        Background="#08162B" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MainMenuViewModel}">
            <views:MainMenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FleetPlacementViewModel}">
            <views:FleetPlacementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BattleViewModel}">
            <views:BattleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ResultViewModel}">
            <views:ResultView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LeaderboardViewModel}">
            <views:LeaderboardView/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
