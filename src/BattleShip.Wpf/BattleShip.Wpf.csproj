<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BattleShip.Wpf</RootNamespace>
    <AssemblyName>BattleShip.Wpf</AssemblyName>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleShip.Domain\BattleShip.Domain.csproj" />
    <ProjectReference Include="..\BattleShip.Application\BattleShip.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.jpg" />
  </ItemGroup>

</Project>
