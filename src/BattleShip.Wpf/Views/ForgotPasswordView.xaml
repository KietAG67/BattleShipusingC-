<UserControl x:Class="BattleShip.Wpf.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0E2D49">
        <Viewbox Stretch="Uniform">
            <!-- Toạ độ bên dưới tính theo pixel của ảnh ForgotPassword.jpg (930 x 750) -->
            <Canvas Width="930" Height="750">
                <Image Source="pack://application:,,,/Assets/Backgrounds/ForgotPassword.jpg" Width="930" Height="750" Stretch="Fill"/>

                <!-- Email -->
                <TextBox Canvas.Left="284" Canvas.Top="405" Width="414" Height="43"
                         Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                         VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="0"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendResetLinkCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Canvas.Left="290" Canvas.Top="415" Text="Email Address" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Email}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Thông báo lỗi / thành công -->
                <TextBlock Canvas.Left="200" Canvas.Top="588" Width="530" Height="20" TextAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Text="{Binding Message}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E8449"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- SEND RESET LINK -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="240" Canvas.Top="477" Width="459" Height="52"
                        Command="{Binding SendResetLinkCommand}"/>

                <!-- Back to Login -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="246" Canvas.Top="552" Width="150" Height="28"
                        Command="{Binding LoginCommand}"/>

                <!-- Link Login ở góc dưới -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="636" Canvas.Top="552" Width="60" Height="28"
                        Command="{Binding LoginCommand}"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
