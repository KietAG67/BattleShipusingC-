<UserControl x:Class="BattleShip.Wpf.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#04142B">
        <Viewbox Stretch="Uniform">
            <!-- Toạ độ tính theo pixel của ảnh MainMenu.jpg (1040 x 762) -->
            <Canvas Width="1040" Height="762">
                <Image Source="pack://application:,,,/Assets/Backgrounds/MainMenu.jpg" Width="1040" Height="762" Stretch="Fill"/>

                <!-- START GAME / LEADERBOARD / EXIT: nút trong suốt đè lên nút trong ảnh -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="303" Canvas.Top="265" Width="430" Height="76"
                        Command="{Binding StartGameCommand}"/>
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="303" Canvas.Top="372" Width="430" Height="76"
                        Command="{Binding LeaderboardCommand}"/>
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="303" Canvas.Top="480" Width="430" Height="75"
                        Command="{Binding ExitCommand}"/>

                <!-- Bảng chọn độ khó (hiện sau khi bấm START GAME) -->
                <Grid Canvas.Left="0" Canvas.Top="0" Width="1040" Height="762"
                      Visibility="{Binding IsDifficultyOpen, Converter={StaticResource BoolToVis}}">
                    <Rectangle Fill="#A6000000"/>
                    <Border Width="560" Height="440" Background="#F3F6FA" BorderBrush="#1F3556" BorderThickness="2"
                            CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="40,26">
                            <TextBlock Text="SELECT DIFFICULTY" FontSize="32" FontWeight="Bold" Foreground="#0B1E3D"
                                       HorizontalAlignment="Center"/>

                            <Button Style="{StaticResource OverlayButton}" Background="#1F3556" BorderBrush="#4A6A96"
                                    BorderThickness="1" Foreground="White" Height="72" Margin="0,22,0,0"
                                    Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy">
                                <StackPanel>
                                    <TextBlock Text="EASY" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="The bot fires at random" FontSize="14" Foreground="#C5D3E8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OverlayButton}" Background="#1F3556" BorderBrush="#4A6A96"
                                    BorderThickness="1" Foreground="White" Height="72" Margin="0,22,0,0"
                                    Command="{Binding SelectDifficultyCommand}" CommandParameter="Medium">
                                <StackPanel>
                                    <TextBlock Text="MEDIUM" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="The bot hunts around its hits" FontSize="14" Foreground="#C5D3E8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OverlayButton}" Background="#1F3556" BorderBrush="#4A6A96"
                                    BorderThickness="1" Foreground="White" Height="72" Margin="0,22,0,0"
                                    Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard">
                                <StackPanel>
                                    <TextBlock Text="HARD" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="The bot calculates ship probabilities" FontSize="14" Foreground="#C5D3E8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OverlayButton}" Foreground="#1F3556" Height="40" Margin="0,14,0,0"
                                    Command="{Binding CancelDifficultyCommand}">
                                <TextBlock Text="Back" FontSize="18" FontWeight="SemiBold" Foreground="#1F3556"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
