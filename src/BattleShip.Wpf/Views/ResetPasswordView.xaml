<UserControl x:Class="BattleShip.Wpf.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BattleShip.Wpf.Helpers">
    <Grid Background="#0E2D49">
        <Viewbox Stretch="Uniform">
            <!-- Toạ độ bên dưới tính theo pixel của ảnh ResetPassword.jpg (955 x 746) -->
            <Canvas Width="955" Height="746">
                <Image Source="pack://application:,,,/Assets/Backgrounds/ResetPassword.jpg" Width="955" Height="746" Stretch="Fill"/>

                <!-- Verification Code (mã gửi qua email) -->
                <TextBox Canvas.Left="296" Canvas.Top="401" Width="418" Height="44"
                         Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                         VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="0"
                         Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Canvas.Left="302" Canvas.Top="411" Text="Verification Code" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerificationCode}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- New Password -->
                <PasswordBox Canvas.Left="296" Canvas.Top="471" Width="418" Height="45"
                             Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                             VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="1" PasswordChar="●"
                             helpers:PasswordBoxAssist.Attach="True"
                             helpers:PasswordBoxAssist.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBlock Canvas.Left="302" Canvas.Top="482" Text="New Password" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNewPassword}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Thông báo lỗi / thành công -->
                <TextBlock Canvas.Left="200" Canvas.Top="650" Width="555" Height="20" TextAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Text="{Binding Message}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E8449"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- CONFIRM -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="256" Canvas.Top="544" Width="458" Height="48"
                        Command="{Binding ConfirmCommand}"/>

                <!-- Back to Login -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="262" Canvas.Top="618" Width="150" Height="28"
                        Command="{Binding LoginCommand}"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
