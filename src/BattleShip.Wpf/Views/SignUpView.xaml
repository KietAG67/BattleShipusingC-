<UserControl x:Class="BattleShip.Wpf.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BattleShip.Wpf.Helpers">
    <Grid Background="#0E2D49">
        <Viewbox Stretch="Uniform">
            <!-- Toạ độ bên dưới tính theo pixel của ảnh SignUp.jpg (931 x 771) -->
            <Canvas Width="931" Height="771">
                <Image Source="pack://application:,,,/Assets/Backgrounds/SignUp.jpg" Width="931" Height="771" Stretch="Fill"/>

                <!-- Username -->
                <TextBox Canvas.Left="282" Canvas.Top="284" Width="410" Height="40"
                         Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                         VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignUpCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Canvas.Left="288" Canvas.Top="293" Text="Username" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Username}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Email -->
                <TextBox Canvas.Left="282" Canvas.Top="334" Width="410" Height="40"
                         Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                         VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="1"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignUpCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Canvas.Left="288" Canvas.Top="343" Text="Email" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Email}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Password -->
                <PasswordBox Canvas.Left="282" Canvas.Top="384" Width="410" Height="40"
                             Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                             VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="2" PasswordChar="●"
                             helpers:PasswordBoxAssist.Attach="True"
                             helpers:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignUpCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBlock Canvas.Left="288" Canvas.Top="393" Text="Password" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPassword}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Confirm Password -->
                <PasswordBox Canvas.Left="282" Canvas.Top="436" Width="410" Height="40"
                             Background="#CDD4DC" BorderThickness="0" FontSize="17" Foreground="#1B2B3C"
                             VerticalContentAlignment="Center" Padding="6,0,0,0" TabIndex="3" PasswordChar="●"
                             helpers:PasswordBoxAssist.Attach="True"
                             helpers:PasswordBoxAssist.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignUpCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBlock Canvas.Left="288" Canvas.Top="445" Text="Confirm Password" FontSize="17"
                           Foreground="#7A8795" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConfirmPassword}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Terms & Conditions: ô vuông đã vẽ sẵn, nút trong suốt đè lên, dấu tích hiện khi được chọn -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="236" Canvas.Top="489" Width="330" Height="26"
                        Command="{Binding ToggleTermsCommand}"/>
                <Grid Canvas.Left="239" Canvas.Top="491" Width="20" Height="20" IsHitTestVisible="False"
                      Visibility="{Binding AgreeTerms, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold" Foreground="#1F4E8C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- SIGN UP -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="237" Canvas.Top="538" Width="459" Height="52"
                        Command="{Binding SignUpCommand}"/>

                <!-- Login now -->
                <Button Style="{StaticResource OverlayButton}" Foreground="#1F4E8C" Canvas.Left="528" Canvas.Top="612"
                        Width="92" Height="26" Command="{Binding LoginCommand}"/>

                <!-- Thông báo lỗi / thành công -->
                <TextBlock Canvas.Left="200" Canvas.Top="641" Width="531" Height="22" TextAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Text="{Binding Message}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E8449"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
