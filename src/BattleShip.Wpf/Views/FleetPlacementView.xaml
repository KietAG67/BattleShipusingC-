<UserControl x:Class="BattleShip.Wpf.Views.FleetPlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BattleShip.Wpf.Views"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- Lớp phủ cho mỗi thẻ tàu trong bảng "Available Ships" của ảnh nền -->
        <DataTemplate x:Key="CardOverlay">
            <Grid Width="339" Height="72">
                <Border BorderBrush="#FFB300" BorderThickness="3" CornerRadius="6" Background="#26FFB300"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Padding="10,1"
                        CornerRadius="11" IsHitTestVisible="False"
                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0B2A52"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Background" Value="#2E9E5B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </Border>
                <Button Style="{StaticResource OverlayButton}" Foreground="#1F3556"
                        Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#08223D">
        <Viewbox Stretch="Uniform">
            <!-- Toạ độ tính theo pixel của ảnh FleetPlacement.jpg (1056 x 766) -->
            <Canvas Width="1056" Height="766">
                <Image Source="pack://application:,,,/Assets/Backgrounds/FleetPlacement.jpg" Width="1056" Height="766" Stretch="Fill"/>

                <!-- Lưới 10x10 đặt đúng lên lưới trong ảnh -->
                <views:BoardGridView Canvas.Left="156.5" Canvas.Top="173" Width="411.5" Height="416.5"
                                     DataContext="{Binding PlacementBoard}"
                                     BaseBrush="#92BDDF" LineBrush="#A8D1E5" FrameBrush="#0A2A43"/>
                <!-- Lớp bắt chuột: rê = xem trước, chuột trái = đặt, chuột phải = nhấc tàu lên -->
                <Border x:Name="PlacementHit" Canvas.Left="156.5" Canvas.Top="173" Width="411.5" Height="416.5"
                        Background="Transparent"
                        MouseMove="OnGridMouseMove" MouseLeave="OnGridMouseLeave"
                        MouseLeftButtonDown="OnGridLeftClick" MouseRightButtonDown="OnGridRightClick"/>

                <!-- Bảng Available Ships: 4 thẻ, mỗi thẻ một tàu -->
                <ContentControl Canvas.Left="606" Canvas.Top="179" Content="{Binding Cards[0]}" ContentTemplate="{StaticResource CardOverlay}"/>
                <ContentControl Canvas.Left="606" Canvas.Top="262" Content="{Binding Cards[1]}" ContentTemplate="{StaticResource CardOverlay}"/>
                <ContentControl Canvas.Left="606" Canvas.Top="344" Content="{Binding Cards[2]}" ContentTemplate="{StaticResource CardOverlay}"/>
                <ContentControl Canvas.Left="606" Canvas.Top="428" Content="{Binding Cards[3]}" ContentTemplate="{StaticResource CardOverlay}"/>

                <!-- Độ khó đã chọn (hiện trên thanh tiêu đề) -->
                <TextBlock Canvas.Left="100" Canvas.Top="71" Text="{Binding DifficultyText}" FontSize="15"
                           FontWeight="SemiBold" Foreground="#C9D6E6" IsHitTestVisible="False"/>

                <!-- Dòng hướng dẫn dưới lưới -->
                <TextBlock Canvas.Left="160" Canvas.Top="596" Width="408" Height="22" Text="{Binding StatusText}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#1B2B3C" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>

                <!-- Viền xanh báo đã sẵn sàng xác nhận -->
                <Border Canvas.Left="391" Canvas.Top="619" Width="268" Height="72" BorderBrush="#8CFF9E" BorderThickness="3"
                        CornerRadius="8" IsHitTestVisible="False"
                        Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}"/>

                <!-- Nút trong suốt đặt đè lên nút trong ảnh: Rotate / Clear / Confirm / dấu X -->
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="610" Canvas.Top="536" Width="156" Height="48"
                        Command="{Binding RotateCommand}"/>
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="786" Canvas.Top="536" Width="156" Height="48"
                        Command="{Binding ClearCommand}"/>
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="393" Canvas.Top="621" Width="264" Height="68"
                        Command="{Binding ConfirmCommand}"/>
                <Button Style="{StaticResource OverlayButton}" Canvas.Left="924" Canvas.Top="63" Width="36" Height="36"
                        Command="{Binding BackCommand}"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
