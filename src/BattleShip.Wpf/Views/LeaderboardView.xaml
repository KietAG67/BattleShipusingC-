<UserControl x:Class="BattleShip.Wpf.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1E1E2E" Padding="30">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TOP PLAYERS LEADERBOARD" FontSize="26" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding TopPlayers}" AutoGenerateColumns="False" IsReadOnly="True" Background="#11111B" RowBackground="#1E1E2E" AlternatingRowBackground="#181825" Foreground="#CDD6F4" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="80"/>
                <DataGridTextColumn Header="Player" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Back to Menu" Command="{Binding BackToMenuCommand}" Height="40" Width="180" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
    </Border>
</UserControl>