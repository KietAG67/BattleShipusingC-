<UserControl x:Class="BattleShip.Wpf.Views.BoardGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:BattleShip.Wpf.Effects"
             xmlns:views="clr-namespace:BattleShip.Wpf.Views">
    <!-- DataContext = BoardViewModel. Xếp lớp: nền -> đường lưới (+ tô màu xem trước) -> hình tàu -> dấu bắn/hiệu ứng -> viền ngoài. -->
    <Grid>
        <!-- Nền đặc để che hình mẫu đã vẽ sẵn trong ảnh nền -->
        <Border Background="{Binding BaseBrush, RelativeSource={RelativeSource AncestorType={x:Type views:BoardGridView}}}"/>

        <!-- Lớp 1: đường lưới + màu xem trước khi đặt tàu -->
        <ItemsControl ItemsSource="{Binding Cells}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="10" Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0.5"
                            BorderBrush="{Binding LineBrush, RelativeSource={RelativeSource AncestorType={x:Type views:BoardGridView}}}">
                        <Grid>
                            <Border Background="#2ECC71" Opacity="0.45"
                                    Visibility="{Binding IsPreviewValid, Converter={StaticResource BoolToVis}}"/>
                            <Border Background="#E74C3C" Opacity="0.5"
                                    Visibility="{Binding IsPreviewInvalid, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lớp 2: hình tàu (đặt theo Row/Column/Span trong lưới 10x10) -->
        <ItemsControl ItemsSource="{Binding Ships}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding Row}"/>
                    <Setter Property="Grid.Column" Value="{Binding Column}"/>
                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Image}" Opacity="{Binding Opacity}" Stretch="Fill" Margin="2"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lớp 3: dấu bắn trúng/trượt, ô đang ngắm, và nút bấm trong suốt (chỉ khi IsInteractive) -->
        <ItemsControl ItemsSource="{Binding Cells}"
                      IsHitTestVisible="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType={x:Type views:BoardGridView}}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="10" Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border BorderBrush="#E53935" BorderThickness="2" Background="#33E53935" CornerRadius="3" Margin="1"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                        <fx:SpriteView Sprite="splash" NextSprite="ripple" Margin="-4"
                                       Visibility="{Binding IsMiss, Converter={StaticResource BoolToVis}}"/>
                        <fx:SpriteView Sprite="explosion" NextSprite="fire" Margin="-6"
                                       Visibility="{Binding IsHit, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource OverlayButton}" Foreground="#1F3556"
                                Command="{Binding ClickCommand}" IsEnabled="{Binding IsClickable}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Viền ngoài -->
        <Border BorderBrush="{Binding FrameBrush, RelativeSource={RelativeSource AncestorType={x:Type views:BoardGridView}}}"
                BorderThickness="1.5" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
